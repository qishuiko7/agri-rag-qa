# ============================================================
# 农业智能问答助手 - 环境配置模板
# 复制为 .env 后填入真实密钥
# ============================================================

# ---------- 阿里云百炼（DashScope）----------
# 一把 Key 同时用于对话和向量化，控制台：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 智谱 AI（备选）----------
# 控制台：https://bigmodel.cn/
ZHIPU_API_KEY=

# ---------- 模型选择 ----------
# 对话模型提供方：dashscope | zhipu | mock
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
# 向量模型提供方：dashscope | zhipu | mock
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- RAG 参数（对齐文档第七章节能优化策略）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
MEMORY_ROUNDS=5
BATCH_SIZE=30

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
